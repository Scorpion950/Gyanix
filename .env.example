# Gyanix — Environment Variables Template
# Copy this file to .env in each app and fill in the values.
# NEVER commit real values to version control.

# ============================================================
# apps/web — Vite frontend (prefix VITE_ for browser exposure)
# ============================================================

# Supabase — public (safe to expose to browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# API base URL
VITE_API_URL=http://localhost:3001/api

# App settings
VITE_APP_URL=http://localhost:5173

# ============================================================
# apps/api — Express serverless backend (server-side only)
# ============================================================

# Supabase — server (NEVER expose these to the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI providers (server-side only)
GEMINI_API_KEY=your-gemini-api-key

# Encryption key for runtime-stored API keys (AES-256-GCM, 32 bytes hex)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# CORS — allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app

# App URL (used for auth redirects)
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# Node environment
NODE_ENV=development

# YouTube Data API (optional — quota-aware)
YOUTUBE_API_KEY=your-youtube-api-key

# SMTP (Brevo free tier — 300 emails/day)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=noreply@yourdomain.com
